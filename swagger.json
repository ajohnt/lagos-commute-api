{
  "openapi": "3.0.0",
  "info": {
    "title": "Lagos Commute Planner API",
    "description": "Backend REST API for BRT, Danfo & Keke Route Finder with Fare Estimator and Live Reports. Capstone by John Agada (BAD/2026/TC-9/0012)",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://lagos-commute-api.onrender.com" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  },
  "paths": {
    "/api/health": { "get": { "summary": "Health check", "responses": { "200": { "description": "OK" } } } },
    "/api/auth/register": { "post": { "summary": "Register user", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "password": { "type": "string" }, "role": { "type": "string", "enum": ["user", "admin"] } } } } } }, "responses": { "201": { "description": "Created" } } } },
    "/api/auth/login": { "post": { "summary": "Login, returns JWT", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } } }, "responses": { "200": { "description": "JWT token" } } } },
    "/api/routes": {
      "get": { "summary": "Get all routes / Search ?from=Ikeja&to=Yaba", "responses": { "200": { "description": "List" } } },
      "post": { "summary": "Admin creates route", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created" } } }
    },
    "/api/routes/search": { "get": { "summary": "Search routes", "responses": { "200": { "description": "List" } } } },
    "/api/routes/compare": { "get": { "summary": "Compare cheapest vs fastest", "responses": { "200": { "description": "Compare" } } } },
    "/api/routes/{id}": {
      "get": { "summary": "Get one route with stops", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Route" } } },
      "put": { "summary": "Admin updates route / fare", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "summary": "Admin deletes route", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Deleted" } } }
    },
    "/api/fares": { "get": { "summary": "Get fare ?from=X&to=Y", "responses": { "200": { "description": "Fares" } } } },
    "/api/geocode": { "get": { "summary": "Geocode via OpenStreetMap Nominatim ?address=Ikeja", "responses": { "200": { "description": "Lat/Lon" } } } },
    "/api/reports": {
      "get": { "summary": "Get approved reports", "responses": { "200": { "description": "List" } } },
      "post": { "summary": "Create live report", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created" } } }
    },
    "/api/admin/reports/{id}/approve": { "patch": { "summary": "Admin approves report", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Approved" } } } },
    "/api/saved-routes": {
      "get": { "summary": "Get my saved routes", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "List" } } },
      "post": { "summary": "Save a route", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Saved" } } }
    }
  }
}